---
import { getLiveCollection } from 'astro:content';
const livePlaces = await getLiveCollection('places');
const places = livePlaces.entries?.map(({ data }) => data) ?? [];
const location = places
    .filter(({ latitude, longitude }) => latitude !== undefined && longitude !== undefined)
    .map(({ latitude, longitude }) => ({
    location: [latitude, longitude] as [number, number],
    size: 0.03
}));
---
<div class="my-8">
    沿着此线前行，但见大江大川。
</div>

<canvas
        id="cobe"
        style="width: 400px; height: 400px;margin: 0 auto;display: block;"
        width="800"
        height="800"
        data-location={JSON.stringify(location)}
></canvas>

<script>
    import createGlobe from "cobe";
    let canvas = document.getElementById("cobe") as HTMLCanvasElement;
    const locations = JSON.parse(canvas.dataset.location);

    createGlobe(canvas, {
        devicePixelRatio: 2,
        width: 400 * 2,
        height: 400 * 2,
        phi: Math.PI -0.25,
        theta: 0.7,
        dark: 0,
        diffuse: 1,
        mapSamples: 36000,
        mapBrightness: 3,
        baseColor: [0.8, 0.8, 0.8], // 更改为深蓝色
        markerColor: [0.9, 0.1, 0.1], // 更改为红色
        glowColor: [0.5, 0.5, 0.5], // 更改
        markers:locations,
        scale: 1.1,
        onRender: (_state) => {
        }
    });
</script>

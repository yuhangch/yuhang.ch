---
import { useLocale } from "../../utils/locale";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { projects, stacks } from "../../data/whois";

const { t, locale } = useLocale(Astro.url);
export const prerender = false;

const allWhoisEntries = await getCollection("whois");
const preferredLang = locale === "en" ? "en" : "zh";

let whoisEntry = allWhoisEntries.find(
    (entry) => entry.data?.lang === preferredLang,
);

if (!whoisEntry) {
    whoisEntry =
        allWhoisEntries.find((entry) => entry.data?.lang === "zh") ??
        allWhoisEntries[0];
}

if (!whoisEntry) {
    throw new Error('[whois] No entries found in "whois" collection');
}

const { Content } = await render(whoisEntry);
---

<Layout title={t("nav.whois")}>
    <main>
        <div class="my-8 mx-4">
            <Content />
        </div>

        <div
            data-orientation="horizontal"
            role="separator"
            class="my-8 h-px w-full bg-stone-200"
        ></div>

        <section>
            <h2 class="my-8 text-xl font-medium">Projects</h2>
            <ul class="grid grid-cols-1 gap-3 p-1">
                {projects.map((project) => <ResourceCard {...project} />)}
            </ul>
        </section>

        <section class="mt-8">
            <h2 class="mb-3 text-xl font-medium">Stacks</h2>
            <ul class="grid grid-cols-2 gap-3 p-1">
                {stacks.map((stack) => <ResourceCard {...stack} />)}
            </ul>
        </section>
    </main>
</Layout>

---
import { getCollection } from 'astro:content';
import { getLocale } from 'astro-i18n-aut';
import { entryExtension, entryToMarkdown, findEntry } from '../../../utils/markdown/content';
import { markdownResponse } from '../../../utils/markdown/response';

export const prerender = false;

const pathname = Astro.url.pathname;
const slugParts = pathname.split('/').filter(Boolean);
const postsIndex = slugParts.indexOf('posts');
const fullSlug = postsIndex >= 0 ? slugParts.slice(postsIndex + 1).join('/') : '';
const requestedExtension = fullSlug.match(/\.(md|mdx)$/)?.[1] as 'md' | 'mdx' | undefined;
const postSlug = fullSlug.replace(/\.(md|mdx)$/, '');

const locale = getLocale(Astro.url) || 'zh';
const collectionName = locale === 'en' ? 'posts-en' : 'posts';

try {
    const collection = await getCollection(collectionName);
    const entry = findEntry(collection, postSlug);

    if (!entry) {
        return new Response(`Entry not found for slug: ${postSlug}`, { status: 404 });
    }

    if (!entry.body) {
        return new Response('Content not found', { status: 404 });
    }

    const fileExtension = requestedExtension ?? entryExtension(entry);

    return markdownResponse(entryToMarkdown(entry), {
        contentType: `${fileExtension === 'md' ? 'text/markdown' : 'text/mdx'}; charset=utf-8`,
        filename: `${postSlug}.${fileExtension}`,
    });
} catch (error) {
    console.error('Error in raw content endpoint:', error);
    return new Response('Unable to load content', { status: 500 });
}
---

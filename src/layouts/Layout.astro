---
import '../styles/index.css'
import Header from './Header.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import {useLocale} from '@utils/locale'
import { getLocalePath, stripLocaleFromPath } from '@utils/locale'
import { ClientRouter } from 'astro:transitions'

const {t, locale} = useLocale(Astro.url, Astro.locals.locale)

export interface Props {
    title: string
    navbar?: boolean
    description?: string
    ogType?: string
    publishedTime?: Date | string
    modifiedTime?: Date | string
}

let {
    title,
    navbar = true,
    description = t('layout.description'),
    ogType = 'website',
    publishedTime,
    modifiedTime,
} = Astro.props
const fullTitle = `${title} - ${t('layout.title')}`
const basePath = stripLocaleFromPath(Astro.locals.originalPathname ?? Astro.url.pathname)
const canonicalPath = getLocalePath(locale, basePath)
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath
const makeCanonical = (targetLocale: 'zh' | 'en') => {
    const path = getLocalePath(targetLocale, basePath)
    return Astro.site ? new URL(path, Astro.site).toString() : path
}
const zhCanonical = Astro.site
    ? makeCanonical('zh')
    : makeCanonical('zh')
const enCanonical = makeCanonical('en')

const toIsoString = (value?: Date | string) => {
    if (!value) return undefined
    if (value instanceof Date) return value.toISOString()
    const parsed = new Date(value)
    return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString()
}

const publishedIso = toIsoString(publishedTime)
const modifiedIso = toIsoString(modifiedTime)
---

<!doctype html>
<html lang={locale} class="mx-4">
<head>
    <ClientRouter />
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhCanonical} />
    <link rel="alternate" hreflang="en-US" href={enCanonical} />
    <link rel="alternate" hreflang="x-default" href={zhCanonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('layout.title')} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    {publishedIso && (
        <meta property="article:published_time" content={publishedIso} />
    )}
    {modifiedIso && (
        <meta property="article:modified_time" content={modifiedIso} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <title>{fullTitle}</title>
</head>
<body class="dark:bg-stone-900 bg-[#FBFBFBFF]">
    <div class="max-width">
        <Header/>
        {navbar && <Navbar/>}
        <main>
            <slot/>
        </main>
        <Footer/>
    </div>
</body>
</html>
